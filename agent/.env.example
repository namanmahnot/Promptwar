# Copy to agent/.env for local runs. Never commit real values.
APP_ENV=development
GEMINI_API_KEY=
GOOGLE_GENAI_USE_VERTEXAI=false
GEMINI_MODEL_SQL=gemini-3.5-flash
GEMINI_MODEL_LITE=gemini-3.5-flash-lite
GCP_PROJECT=your-project-id
BQ_MAX_BYTES=1000000000
PROMPT_VERSION=v1
# Optional defence-in-depth shared secret between gateway and agent (32+ random chars)
INTERNAL_API_KEY=
