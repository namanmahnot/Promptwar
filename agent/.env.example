# Copy to agent/.env for local runs. Never commit real values.
APP_ENV=development
GEMINI_API_KEY=
GEMINI_MODEL_SQL=gemini-3.5-flash
GEMINI_MODEL_LITE=gemini-3.5-flash-lite
GCP_PROJECT=promptwar-naman
BQ_MAX_BYTES=1000000000
PROMPT_VERSION=v1
# memory (local) or firestore
STORE=memory
# Local only: accept the token "dev" without Firebase. Refused unless APP_ENV=development.
AUTH_DEV_BYPASS=true
# Optional: service-account key JSON (one line) when not using `gcloud auth application-default login`
GOOGLE_SERVICE_ACCOUNT_JSON=
