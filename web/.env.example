# Firebase web config (public by design). Copy to web/.env.production; values from `firebase apps:sdkconfig web`.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=promptwar-naman.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=promptwar-naman
VITE_FIREBASE_APP_ID=
# Leave empty when the API serves the app (same origin). Set only if the web app is hosted elsewhere.
VITE_API_URL=
# Local only, when Firebase is not configured and the API runs with AUTH_DEV_BYPASS=true
VITE_AUTH_DEV_BYPASS=false
